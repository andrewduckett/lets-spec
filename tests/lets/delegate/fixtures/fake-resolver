#!/usr/bin/env node
// A resolver for tests, driven by environment variables. Each may end in
// _<VERB>, such as FAKE_RESOLVER_EXIT_FINISH, to apply to one verb only.
// For a probe, _PROBE_<VERB>, such as FAKE_RESOLVER_EXIT_PROBE_START, applies
// to the probe for that verb only, ahead of _PROBE.
//
//   FAKE_RESOLVER_STDOUT    what to print; default, a valid response for the verb
//   FAKE_RESOLVER_STDERR    what to print on stderr
//   FAKE_RESOLVER_EXIT      the exit code; default 0
//   FAKE_RESOLVER_SLEEP_MS  how long to wait before answering
//   FAKE_RESOLVER_FAMILY    the family a run answers with; default gpt
//   FAKE_RESOLVER_REFUSE    models, comma-separated, that a run or start
//                           refuses with exit 3 and "refused <model>" on stderr
//   FAKE_RESOLVER_LOG       a file to append one line per call to: the
//                           verb, a tab, and the request as read
const { appendFileSync } = await import('node:fs');

const verb = process.argv[2] ?? '';
let input = '';
for await (const chunk of process.stdin) input += chunk;
// The verb a probe is for, when its request says.
const probeFor = (() => {
  if (verb !== 'probe') return '';
  try { return String(JSON.parse(input).verb ?? ''); } catch { return ''; }
})();
const setting = (name) => (probeFor ? process.env[`FAKE_RESOLVER_${name}_PROBE_${probeFor.toUpperCase()}`] : undefined)
  ?? process.env[`FAKE_RESOLVER_${name}_${verb.toUpperCase()}`] ?? process.env[`FAKE_RESOLVER_${name}`];

const RESPONSES = {
  probe: { resolver: 'fake', options: ['gpt/fake-model'] },
  run: { resolver: 'fake', text: 'FINDINGS', family: setting('FAMILY') ?? 'gpt', model: 'fake-model', handle: { kind: 'fake', id: 'f-1', extra: 'kept' } },
  start: { resolver: 'fake', handle: { kind: 'fake', id: 'f-1' } },
  finish: {},
};

if (process.env.FAKE_RESOLVER_LOG) appendFileSync(process.env.FAKE_RESOLVER_LOG, `${verb}\t${input.replace(/\n/g, ' ')}\n`);
const sleepMs = Number(setting('SLEEP_MS') ?? 0);
if (sleepMs > 0) await new Promise((resolve) => setTimeout(resolve, sleepMs));

if ((verb === 'run' || verb === 'start') && (setting('REFUSE') ?? '').split(',').includes(JSON.parse(input).model)) {
  process.stderr.write(`refused ${JSON.parse(input).model}\n`);
  process.exit(3);
}

const stdout = setting('STDOUT') ?? (verb in RESPONSES ? JSON.stringify(RESPONSES[verb]) : '');
if (stdout !== '') process.stdout.write(`${stdout}\n`);
if (setting('STDERR')) process.stderr.write(`${setting('STDERR')}\n`);
process.exitCode = Number(setting('EXIT') ?? (verb in RESPONSES ? 0 : 2));
