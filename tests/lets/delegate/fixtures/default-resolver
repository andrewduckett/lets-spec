#!/usr/bin/env node
// The built-in default resolver as an executable, so the conformance check
// can run against it the way it runs against any other resolver.
const { realIo } = await import('../../../../lets/src/io.ts');
const { createDefaultResolver } = await import('../../../../lets/src/delegate/default-resolver.ts');
const { exitCodeOf } = await import('../../../../lets/src/delegate/errors.ts');
const { parseRequest } = await import('../../../../lets/src/delegate/protocol.ts');

const verb = process.argv[2] ?? '';
let input = '';
for await (const chunk of process.stdin) input += chunk;

try {
  const request = parseRequest(verb, input);
  const { code, response, stderr } = await createDefaultResolver(realIo(), process.env).handle(verb, request);
  if (response !== null) process.stdout.write(`${JSON.stringify(response)}\n`);
  if (stderr) process.stderr.write(`${stderr}\n`);
  process.exitCode = code;
} catch (error) {
  const code = exitCodeOf(error);
  if (code === null) throw error;
  process.stderr.write(`default-resolver: ${error.message}\n`);
  process.exitCode = code;
}
