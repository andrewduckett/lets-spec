#!/usr/bin/env node
// The dev entry: Node runs the TypeScript source with type stripping. The
// release runs dist/lets-delegate-t3, which lets/build.mjs makes
// with the same check on top.
if (Number(process.versions.node.split('.')[0]) < 26) {
  process.stderr.write(`lets-delegate-t3: needs Node 26 or later, and this is Node ${process.versions.node}.\n`);
  process.exit(1);
}
import('../src/resolvers/t3/main.ts');
